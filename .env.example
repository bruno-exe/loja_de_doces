# Credenciais existentes para a compra de pontos (integração principal)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USER_ID=
MERCADOPAGO_MODE=test
REAL_PAYMENTS_ENABLED=false
PUBLIC_BASE_URL=

# OAuth individual das contas de vendedores (integração adicional)
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_REDIRECT_URI=https://comedoce.com.br/integracoes/mercadopago/callback

# Opcional: chave Fernet ou frase secreta própria. Se vazia, deriva de APP_SECRET.
OAUTH_TOKEN_ENCRYPTION_KEY=

# OCR local de comprovantes no Raspberry Pi
OCR_ENGINE=paddle_ncnn
PADDLEOCR_NCNN_ROOT=/home/adm/PaddleOCR-Lite-Document
PADDLEOCR_NCNN_EXECUTABLE=/home/adm/PaddleOCR-Lite-Document/ocr
PADDLEOCR_NCNN_MODELS_DIR=/home/adm/PaddleOCR-Lite-Document/models
PADDLEOCR_NCNN_THREADS=2
PADDLEOCR_NCNN_TIMEOUT=45
